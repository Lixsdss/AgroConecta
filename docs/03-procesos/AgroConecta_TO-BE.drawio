    <!-- ============ FICHA / LEYENDAS ============ -->
    <mxCell id="ficha" value="&lt;b&gt;PARTE IV — MODELAMIENTO TO-BE (situación propuesta con AgroConecta)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Nombre:&lt;/b&gt; Publicación y venta directa de cosecha a través de la plataforma&lt;br&gt;&lt;b&gt;Objetivo:&lt;/b&gt; Conectar al agricultor con varios compradores reales el mismo día, con precio de referencia transparente y transacción trazable&lt;br&gt;&lt;b&gt;Participantes:&lt;/b&gt; Agricultor · Plataforma AgroConecta (sistema) · Comprador final · Administrador&lt;br&gt;&lt;b&gt;Inicio:&lt;/b&gt; La cosecha está lista para ser vendida&lt;br&gt;&lt;b&gt;Fin:&lt;/b&gt; (1) Venta directa concretada y registrada · (2) Publicación no aprobada · (3) Reportes de gestión emitidos&lt;br&gt;&lt;br&gt;&lt;b&gt;⚙&lt;/b&gt; = tarea de servicio (automática, ejecutada por el sistema)&amp;nbsp; ·&amp;nbsp; Las actividades sin ⚙ requieren intervención humana" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="40" y="40" width="1600" height="200" as="geometry" />
    </mxCell>

    <mxCell id="leyenda" value="&lt;b&gt;CÓMO EL TO-BE CIERRA LOS PROBLEMAS DEL AS-IS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;P1&lt;/b&gt; Sin precio de mercado&amp;nbsp; →&amp;nbsp; ⚙ Consultar y mostrar precio de referencia &lt;i&gt;(RF-02)&lt;/i&gt;&lt;br&gt;&lt;b&gt;P2&lt;/b&gt; Un solo comprador&amp;nbsp; →&amp;nbsp; ⚙ Publicación en catálogo + varias ofertas comparables &lt;i&gt;(RF-03)&lt;/i&gt;&lt;br&gt;&lt;b&gt;P3&lt;/b&gt; El acopiador fija el precio&amp;nbsp; →&amp;nbsp; El agricultor decide en «¿Acepta alguna oferta?» &lt;i&gt;(RF-04)&lt;/i&gt;&lt;br&gt;&lt;b&gt;P4&lt;/b&gt; Sin comprobante ni historial&amp;nbsp; →&amp;nbsp; ⚙ Registro de transacción + reputación &lt;i&gt;(RF-05, RF-06)&lt;/i&gt;&lt;br&gt;&lt;b&gt;P5&lt;/b&gt; Perecibilidad&amp;nbsp; →&amp;nbsp; ⚙ Alerta de vencimiento y sugerencia de ajuste &lt;i&gt;(RF-07)&lt;/i&gt;&lt;br&gt;&lt;b&gt;P6&lt;/b&gt; Canal informal sin registro&amp;nbsp; →&amp;nbsp; Mensajería interna trazable &lt;i&gt;(RF-04)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Control y gobierno de la plataforma: moderación, roles y reportes &lt;/i&gt;&lt;i&gt;(RF-08, RF-09)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="1680" y="40" width="1790" height="200" as="geometry" />
